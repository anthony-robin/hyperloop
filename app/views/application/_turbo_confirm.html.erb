<dialog id="turbo-confirm">
  <article>
    <form id="popup-modal" method="dialog" tabindex="-1">
      <header>
        <button aria-label="Close" rel="prev"></button>

        <svg
          aria-hidden="true"
          fill="none"
          height="50"
          viewBox="0 0 20 20"
          width="50"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
          ></path>
        </svg>
      </header>

      <p>Êtes-vous sûr ?</p>

      <footer>
        <div class="grid">
          <button class="secondary" value="cancel">
            &cross; Annuler
          </button>

          <button value="confirm">
            &check; Confirmer
          </button>
        </div>
      </footer>
    </form>
  </article>
</dialog>
