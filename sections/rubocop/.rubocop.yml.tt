inherit_from:
  - .rubocop-custom.yml
  - .rubocop-disabled.yml

plugins:
  - rubocop-performance
  - rubocop-rails
  <%- unless options.skip_test? -%>
  - rubocop-minitest
  <%- end -%>

AllCops:
  SuggestExtensions: false
  Exclude:
    - "bin/*"
    - "db/*schema.rb"
    - "lib/generators/**/*"
    - "node_modules/**/*"
    - "vendor/**/*"
    - "tmp/**/*"

Rails/I18nLocaleTexts:
  Enabled: false
